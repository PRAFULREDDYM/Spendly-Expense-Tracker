# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3001"
API_PREFIX="/api"
VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="http://127.0.0.1:3001"
PRIMARY_CURRENCY="USD"
REPORT_HORIZON_DAYS="30"
LOG_LEVEL="debug"

# Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# Auth (custom JWT layer)
JWT_ACCESS_SECRET="<random-64-char-string>"
JWT_REFRESH_SECRET="<random-64-char-string>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
SESSION_COOKIE_NAME="expense_tracker_session"
REFRESH_COOKIE_NAME="expense_tracker_refresh"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_PATH="/"
AUTH_COOKIE_SAMESITE="lax"
AUTH_ISSUER="expense-tracker"

# AI providers (server-side only)
AI_PROVIDER_DEFAULT="groq"
AI_MODEL_DEFAULT="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GROQ_API_KEY=""
NVIDIA_NIM_API_KEY=""
OPENROUTER_API_KEY=""
